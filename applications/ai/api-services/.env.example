AI_API_TOKEN=your-ai-api-token
MONGO_URI=mongodb://localhost:27017
MONGO_DB=citypulse_ai

# Root folder for all model weights.
# Each model gets its own subfolder under this path.
MODEL_DIR=./weights

# Default model selector for the inference service.
DEFAULT_MODEL=occupancy

# Model paths available to the inference service.
MODEL_PATH_OCCUPANCY=mobilenetv2/phase2_weights.pth
MODEL_PATH_VPS_NET=vps-net/Customized.pth

# Licence plate models: detector, character reader and the reader's class list.
MODEL_PATH_PLATE_DETECTOR=plate-detector-yolo26n/best.pt
MODEL_PATH_PLATE_READER=plate-reader-yolo26s/best.pt
MODEL_PATH_PLATE_CLASSES=plate-reader-yolo26s/classes.json
PLATE_MIN_CONFIDENCE=0.4

HOST=0.0.0.0
PORT=8001
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
