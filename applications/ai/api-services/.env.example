AI_API_TOKEN=change-me-in-production
MONGO_URI=mongodb://localhost:27017
MONGO_DB=citypulse_ai

# Root folder for all model weights.
# Each model gets its own subfolder under this path.
MODEL_DIR=./weights

# Weights file for each task, relative to MODEL_DIR.
# Add new tasks here as more models are trained.
OCCUPANCY_MODEL=mobilenetv2/phase2_weights.pth

HOST=0.0.0.0
PORT=8001
