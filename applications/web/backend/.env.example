DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"

# Direct connection for Prisma migrations
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# JWT — use long random strings in production
JWT_SECRET="your-access-token-secret"
JWT_REFRESH_SECRET="your-refresh-token-secret"
JWT_EXPIRES_IN="15m"

# AI inference service
AI_INFERENCE_URL="http://localhost:8001"
AI_API_TOKEN="your-ai-api-token"

# CORS
CORS_ORIGINS="*"

PORT=3001
