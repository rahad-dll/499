generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model divisions {
  id         String      @id @default(uuid()) @db.Uuid
  name       String      @unique @db.VarChar(100)
  is_active  Boolean     @default(true)
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  updated_at DateTime    @updatedAt @db.Timestamptz(6)
  districts  districts[]
}

model districts {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(100)
  division_id String    @db.Uuid
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @updatedAt @db.Timestamptz(6)
  division    divisions @relation(fields: [division_id], references: [id])
  thanas      thanas[]

  @@unique([name, division_id])
  @@index([division_id])
}

model thanas {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(100)
  district_id String    @db.Uuid
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @updatedAt @db.Timestamptz(6)
  district    districts @relation(fields: [district_id], references: [id])
  areas       areas[]

  @@unique([name, district_id])
  @@index([district_id])
}

model areas {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(100)
  thana_id   String   @db.Uuid
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)
  thana      thanas   @relation(fields: [thana_id], references: [id])

  users              users[]
  owner_profiles     owner_profiles[]
  driver_profiles    driver_profiles[]
  authority_profiles authority_profiles[]
  parking_spaces     parking_spaces[]

  @@unique([name, thana_id])
  @@index([thana_id])
}

model roles {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @unique @db.VarChar(50)
  created_at  DateTime           @default(now()) @db.Timestamptz(6)
  updated_at  DateTime           @updatedAt @db.Timestamptz(6)
  deleted_at  DateTime?          @db.Timestamptz(6)
  permissions role_permissions[]
  users       users[]
}

model permissions {
  id         String             @id @default(uuid()) @db.Uuid
  name       String             @unique @db.VarChar(100)
  created_at DateTime           @default(now()) @db.Timestamptz(6)
  updated_at DateTime           @updatedAt @db.Timestamptz(6)
  deleted_at DateTime?          @db.Timestamptz(6)
  roles      role_permissions[]
}

model role_permissions {
  role_id       String      @db.Uuid
  permission_id String      @db.Uuid
  permission    permissions @relation(fields: [permission_id], references: [id])
  role          roles       @relation(fields: [role_id], references: [id])

  @@id([role_id, permission_id])
}

model users {
  id                        String                @id @default(uuid()) @db.Uuid
  email                     String                @unique @db.VarChar(255)
  password_hash             String?               @db.VarChar(255)
  full_name                 String?               @db.VarChar(255)
  phone                     String                @unique @db.VarChar(20)
  phone_verified            Boolean               @default(false)
  role_id                   String                @db.Uuid
  area_id                   String?               @db.Uuid
  is_active                 Boolean               @default(true)
  avatar_url                String?               @db.VarChar(500)
  last_login_at             DateTime?             @db.Timestamptz(6)
  password_reset_token      String?               @db.VarChar(255)
  password_reset_expires_at DateTime?             @db.Timestamptz(6)
  created_at                DateTime              @default(now()) @db.Timestamptz(6)
  updated_at                DateTime              @updatedAt @db.Timestamptz(6)
  deleted_at                DateTime?             @db.Timestamptz(6)
  area                      areas?                @relation(fields: [area_id], references: [id])
  authority_profile         authority_profiles?
  driver_profile            driver_profiles?
  notifications             notifications[]
  owner_profile             owner_profiles?
  parking_spaces            parking_spaces[]
  oauth_accounts            user_oauth_accounts[]
  sessions                  user_sessions[]
  role                      roles                 @relation(fields: [role_id], references: [id])

  @@index([role_id])
  @@index([area_id])
}

model user_sessions {
  id             String    @id @default(uuid()) @db.Uuid
  user_id        String    @db.Uuid
  jti            String    @unique @db.VarChar(255)
  token_hash     String    @db.VarChar(255)
  device_name    String?   @db.VarChar(255)
  ip_address     String?   @db.VarChar(45)
  user_agent     String?   @db.VarChar(500)
  expires_at     DateTime  @db.Timestamptz(6)
  revoked        Boolean   @default(false)
  revoked_at     DateTime? @db.Timestamptz(6)
  revoked_by     String?   @db.Uuid
  revoked_reason String?   @db.VarChar(255)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at     DateTime? @db.Timestamptz(6)
  user           users     @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([jti])
  @@index([revoked])
  @@index([expires_at])
}

model user_oauth_accounts {
  id               String         @id @default(uuid()) @db.Uuid
  user_id          String         @db.Uuid
  provider         oauth_provider
  provider_user_id String         @db.VarChar(255)
  access_token     String?
  refresh_token    String?
  token_expires_at DateTime?      @db.Timestamptz(6)
  created_at       DateTime       @default(now()) @db.Timestamptz(6)
  updated_at       DateTime       @updatedAt @db.Timestamptz(6)
  deleted_at       DateTime?      @db.Timestamptz(6)
  user             users          @relation(fields: [user_id], references: [id])

  @@unique([provider, provider_user_id])
  @@index([user_id])
}

model owner_profiles {
  id            String    @id @default(uuid()) @db.Uuid
  user_id       String    @unique @db.Uuid
  business_name String?   @db.VarChar(255)
  address       String?
  national_id   String?   @db.VarChar(50)
  passport_no   String?   @db.VarChar(50)
  area_id       String?   @db.Uuid
  verified      Boolean   @default(false)
  verified_at   DateTime? @db.Timestamptz(6)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at    DateTime? @db.Timestamptz(6)
  area          areas?    @relation(fields: [area_id], references: [id])
  user          users     @relation(fields: [user_id], references: [id])

  @@index([area_id])
}

model driver_profiles {
  id                       String          @id @default(uuid()) @db.Uuid
  user_id                  String          @unique @db.Uuid
  date_of_birth            DateTime?       @db.Date
  driving_licence_no       String?         @db.VarChar(50)
  licence_type             licence_type?
  vehicle_classes          vehicle_class[]
  fcm_token                String?         @db.VarChar(500)
  area_id                  String?         @db.Uuid
  preferred_payment_method payment_method?
  created_at               DateTime        @default(now()) @db.Timestamptz(6)
  updated_at               DateTime        @updatedAt @db.Timestamptz(6)
  deleted_at               DateTime?       @db.Timestamptz(6)
  area                     areas?          @relation(fields: [area_id], references: [id])
  bookings                 bookings[]
  assigned_slots           parking_slots[]
  user                     users           @relation(fields: [user_id], references: [id])

  @@index([area_id])
}

model authority_profiles {
  id           String    @id @default(uuid()) @db.Uuid
  user_id      String    @unique @db.Uuid
  full_name    String?   @db.VarChar(255)
  organization String?   @db.VarChar(255)
  badge_number String?   @db.VarChar(50)
  area_id      String?   @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at   DateTime? @db.Timestamptz(6)
  area         areas?    @relation(fields: [area_id], references: [id])
  user         users     @relation(fields: [user_id], references: [id])

  @@index([area_id])
}

model parking_spaces {
  id              String          @id @default(uuid()) @db.Uuid
  owner_id        String          @db.Uuid
  name            String          @db.VarChar(255)
  description     String?
  address         String?
  area_id         String?         @db.Uuid
  contact_phone   String?         @db.VarChar(20)
  latitude        Float
  longitude       Float
  space_type      space_type      @default(outdoor)
  total_capacity  Int
  operating_hours Json?
  amenities       String[]
  base_rate_unit  Int?
  max_height_cm   Int?
  status          space_status    @default(pending)
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @updatedAt @db.Timestamptz(6)
  deleted_at      DateTime?       @db.Timestamptz(6)
  area            areas?          @relation(fields: [area_id], references: [id])
  bookings        bookings[]
  cameras         cameras[]
  slots           parking_slots[]
  owner           users           @relation(fields: [owner_id], references: [id])
  pricing_rules   pricing_rules[]
  rate_plans      rate_plans[]
  discounts       discounts[]
  photos          space_photos[]

  @@index([owner_id])
  @@index([status])
  @@index([latitude, longitude])
  @@index([area_id])
}

model parking_slots {
  id                 String            @id @default(uuid()) @db.Uuid
  space_id           String            @db.Uuid
  camera_id          String?           @db.Uuid
  slot_label         String            @db.VarChar(20)
  display_name       String?           @db.VarChar(100)
  zone               String?           @db.VarChar(50)
  floor              String?           @db.VarChar(20)
  sort_order         Int               @default(0)
  slot_type          slot_type         @default(standard)
  vehicle_types      vehicle_kind[]
  length_cm          Int?
  width_cm           Int?
  max_height_cm      Int?
  features           String[]
  ev_charger_kw      Float?
  // normalised to the camera frame: { x1, y1, x2, y2 } in 0-1
  bbox               Json?
  mask_polygon       Json?
  allow_hourly       Boolean           @default(true)
  allow_daily        Boolean           @default(true)
  allow_monthly      Boolean           @default(false)
  is_bookable        Boolean           @default(true)
  status             slot_status       @default(active)
  access_note        String?           @db.VarChar(500)
  assigned_driver_id String?           @db.Uuid
  qr_code            String?           @unique @db.VarChar(64)
  cover_photo_key    String?           @db.VarChar(500)
  occupied           Boolean           @default(false)
  occupancy_source   occupancy_source?
  confidence_score   Float?
  last_updated       DateTime?         @db.Timestamptz(6)
  created_at         DateTime          @default(now()) @db.Timestamptz(6)
  updated_at         DateTime          @updatedAt @db.Timestamptz(6)
  deleted_at         DateTime?         @db.Timestamptz(6)
  bookings           bookings[]
  rate_plans         rate_plans[]
  discounts          discounts[]
  assigned_driver    driver_profiles?  @relation(fields: [assigned_driver_id], references: [id])
  camera             cameras?          @relation(fields: [camera_id], references: [id])
  space              parking_spaces    @relation(fields: [space_id], references: [id])

  @@unique([space_id, slot_label])
  @@index([space_id])
  @@index([occupied])
  @@index([camera_id])
  @@index([space_id, zone])
  @@index([status])
  @@index([assigned_driver_id])
}

// Prices for a whole space, one zone, or one slot. The most specific plan wins: slot, then zone, then space.
model rate_plans {
  id                  String         @id @default(uuid()) @db.Uuid
  space_id            String         @db.Uuid
  zone                String?        @db.VarChar(50)
  slot_id             String?        @db.Uuid
  name                String?        @db.VarChar(100)
  rent_type           rent_type
  // price per unit (hour, day, month, or one entry for flat), in paisa
  amount_unit         Int
  min_units           Int            @default(1)
  max_units           Int?
  grace_minutes       Int            @default(0)
  overstay_rate_unit  Int?
  deposit_unit        Int?
  cancel_free_minutes Int?
  cancel_fee_unit     Int?
  // optional time window: days 0-6 (Sunday = 0), times as HH:MM; empty means always
  days                Int[]
  start_time          String?        @db.VarChar(5)
  end_time            String?        @db.VarChar(5)
  valid_from          DateTime?      @db.Timestamptz(6)
  valid_to            DateTime?      @db.Timestamptz(6)
  is_active           Boolean        @default(true)
  created_at          DateTime       @default(now()) @db.Timestamptz(6)
  updated_at          DateTime       @updatedAt @db.Timestamptz(6)
  deleted_at          DateTime?      @db.Timestamptz(6)
  slot                parking_slots? @relation(fields: [slot_id], references: [id])
  space               parking_spaces @relation(fields: [space_id], references: [id])

  @@index([space_id, rent_type])
  @@index([slot_id])
}

// Scoped like rate_plans. value: percent in basis points (1500 = 15%) or a fixed amount in paisa.
model discounts {
  id         String         @id @default(uuid()) @db.Uuid
  space_id   String         @db.Uuid
  zone       String?        @db.VarChar(50)
  slot_id    String?        @db.Uuid
  name       String         @db.VarChar(100)
  kind       discount_kind
  value      Int
  applies_to rent_type[]
  min_units  Int?
  // empty code means the discount is applied automatically
  code       String?        @db.VarChar(50)
  valid_from DateTime?      @db.Timestamptz(6)
  valid_to   DateTime?      @db.Timestamptz(6)
  max_uses   Int?
  used_count Int            @default(0)
  is_active  Boolean        @default(true)
  created_at DateTime       @default(now()) @db.Timestamptz(6)
  updated_at DateTime       @updatedAt @db.Timestamptz(6)
  deleted_at DateTime?      @db.Timestamptz(6)
  bookings   bookings[]
  slot       parking_slots? @relation(fields: [slot_id], references: [id])
  space      parking_spaces @relation(fields: [space_id], references: [id])

  @@unique([space_id, code])
  @@index([space_id])
  @@index([slot_id])
}

model cameras {
  id             String          @id @default(uuid()) @db.Uuid
  space_id       String          @db.Uuid
  label          String?         @db.VarChar(100)
  rtsp_url       String          @db.VarChar(500)
  status         camera_status   @default(setup)
  last_heartbeat DateTime?       @db.Timestamptz(6)
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime        @updatedAt @db.Timestamptz(6)
  deleted_at     DateTime?       @db.Timestamptz(6)
  space          parking_spaces  @relation(fields: [space_id], references: [id])
  slots          parking_slots[]

  @@index([space_id])
}

model space_photos {
  id         String         @id @default(uuid()) @db.Uuid
  space_id   String         @db.Uuid
  s3_key     String         @db.VarChar(500)
  s3_bucket  String         @db.VarChar(255)
  is_primary Boolean        @default(false)
  created_at DateTime       @default(now()) @db.Timestamptz(6)
  updated_at DateTime       @updatedAt @db.Timestamptz(6)
  deleted_at DateTime?      @db.Timestamptz(6)
  space      parking_spaces @relation(fields: [space_id], references: [id])

  @@index([space_id])
}

model bookings {
  id                  String                @id @default(uuid()) @db.Uuid
  driver_id           String                @db.Uuid
  slot_id             String                @db.Uuid
  space_id            String                @db.Uuid
  status              booking_status        @default(pending)
  rent_type           rent_type             @default(hourly)
  scheduled_at        DateTime              @db.Timestamptz(6)
  end_at              DateTime?             @db.Timestamptz(6)
  extended_to         DateTime?             @db.Timestamptz(6)
  hold_expires_at     DateTime?             @db.Timestamptz(6)
  // check-in and check-out times
  arrived_at          DateTime?             @db.Timestamptz(6)
  departed_at         DateTime?             @db.Timestamptz(6)
  vehicle_plate       String?               @db.VarChar(20)
  base_amount_unit    Int?
  discount_unit       Int?
  discount_id         String?               @db.Uuid
  amount_unit         Int?
  payment_status      payment_status        @default(pending)
  cancellation_reason String?               @db.VarChar(500)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @updatedAt @db.Timestamptz(6)
  deleted_at          DateTime?             @db.Timestamptz(6)
  discount            discounts?            @relation(fields: [discount_id], references: [id])
  driver              driver_profiles       @relation(fields: [driver_id], references: [id])
  slot                parking_slots         @relation(fields: [slot_id], references: [id])
  space               parking_spaces        @relation(fields: [space_id], references: [id])
  payment             payment_transactions?

  @@index([driver_id])
  @@index([slot_id])
  @@index([space_id])
  @@index([status])
  @@index([scheduled_at])
  @@index([slot_id, scheduled_at, end_at])
  @@index([vehicle_plate])
}

model payment_transactions {
  id                 String         @id @default(uuid()) @db.Uuid
  booking_id         String         @unique @db.Uuid
  status             payment_status @default(pending)
  method             payment_method
  amount_unit        Int
  gateway_trx_id     String?        @db.VarChar(255)
  gateway_meta       Json?
  paid_at            DateTime?      @db.Timestamptz(6)
  refunded_at        DateTime?      @db.Timestamptz(6)
  refund_amount_unit Int?
  created_at         DateTime       @default(now()) @db.Timestamptz(6)
  updated_at         DateTime       @updatedAt @db.Timestamptz(6)
  deleted_at         DateTime?      @db.Timestamptz(6)
  booking            bookings       @relation(fields: [booking_id], references: [id])

  @@index([status])
  @@index([gateway_trx_id])
}

model pricing_rules {
  id              String         @id @default(uuid()) @db.Uuid
  space_id        String         @db.Uuid
  surge_threshold Int            @default(80)
  surge_factor_bp Int            @default(15000)
  min_rate_unit   Int?
  max_rate_unit   Int?
  is_active       Boolean        @default(false)
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  updated_at      DateTime       @updatedAt @db.Timestamptz(6)
  deleted_at      DateTime?      @db.Timestamptz(6)
  space           parking_spaces @relation(fields: [space_id], references: [id])

  @@index([space_id])
}

model notifications {
  id         String            @id @default(uuid()) @db.Uuid
  user_id    String            @db.Uuid
  type       notification_type
  title      String            @db.VarChar(255)
  body       String
  ref_id     String?           @db.Uuid
  payload    Json?
  read_at    DateTime?         @db.Timestamptz(6)
  sent_at    DateTime?         @db.Timestamptz(6)
  created_at DateTime          @default(now()) @db.Timestamptz(6)
  updated_at DateTime          @updatedAt @db.Timestamptz(6)
  deleted_at DateTime?         @db.Timestamptz(6)
  user       users             @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([read_at])
  @@index([sent_at])
}

enum space_type {
  indoor
  outdoor
  rooftop
}

enum space_status {
  active
  inactive
  pending
}

enum camera_status {
  active
  offline
  setup
}

enum slot_type {
  standard
  motorcycle
  disabled
  ev
  compact
  large
  bicycle
}

enum slot_status {
  active
  inactive
  maintenance
  blocked
}

enum occupancy_source {
  ai
  booking
  manual
}

enum vehicle_kind {
  car
  motorcycle
  cng
  microbus
  suv
  pickup
}

enum rent_type {
  hourly
  daily
  monthly
  flat
}

enum discount_kind {
  percent
  fixed
}

enum booking_status {
  pending
  confirmed
  cancelled
  completed
  no_show
}

enum payment_status {
  pending
  paid
  failed
  refunded
}

enum payment_method {
  bkash
  nagad
  card
  cash
}

enum notification_type {
  booking_confirmed
  booking_cancelled
  slot_available
  payment_receipt
  system_alert
}

enum oauth_provider {
  google
  facebook
  apple
}

enum licence_type {
  professional
  non_professional
}

// BRTA vehicle classes — a driver can hold multiple
enum vehicle_class {
  H // heavy
  M // medium
  L // light
  C // motorcycle
  T // three-wheeler
  P // public service vehicle
  X // others
}
