# Public URL for the CityPulse API used by the web client.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional, server-only. "Download APK" (/download/apk) asks GitHub's API which
# APK is in applications/mobile/Latest App APK (lib/driver-app/apk.ts). Without a
# token GitHub allows 60 lookups an hour per server; a read-only token for public
# repositories raises that to 5,000. Never prefix it with NEXT_PUBLIC_.
GITHUB_TOKEN=

# NextAuth (server-only). NEXTAUTH_SECRET encrypts the session cookie: generate
# one with `openssl rand -base64 32` and set it in every environment, including
# Vercel. NEXTAUTH_URL is the site's own address; Vercel sets it by itself.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Auth backend: "api" (default, NextAuth + the CityPulse API) or "local" (browser-only
# prototype store for offline UI demos; portal data still needs the API).
NEXT_PUBLIC_AUTH_BACKEND=api

# Google Maps JavaScript API browser key for the owner "Lot map" and the
# authority command center map. Enable "Maps JavaScript API" for the key's
# project and restrict it by HTTP referrer (localhost:3000, your Vercel domain).
# Without it both maps fall back to OpenStreetMap.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional cloud Map ID (vector map). Defaults to Google's DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
